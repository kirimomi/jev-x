# TypeSafe AI (Jev) API Configuration
# Get your API key from TypeSafe AI: https://typesafe.ai/
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Gemini API Configuration (Gemini Decisions evaluation engine)
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
# For the production billing path, use a key from a paid-tier project (e.g. Default Gemini Project).
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenRouter Configuration if routing Jev via OpenRouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Filter Threshold (0.0 - 1.0, default: 0.7)
DEFAULT_FILTER_THRESHOLD=0.7
